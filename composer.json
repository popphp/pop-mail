{
    "name": "popphp/pop-mail",
    "description": "Pop Mail Component for Pop PHP Framework",
    "keywords": [
        "mail",
        "send mail",
        "mail queue",
        "php",
        "pop",
        "pop php"
    ],
    "homepage": "https://github.com/popphp/pop-mail",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Nick Sagona",
            "email": "dev@noladev.com",
            "homepage": "https://www.popphp.org/"
        }
    ],
    "require": {
        "php": ">=8.4.0",
        "popphp/pop-http": "^6.0.0-beta.6",
        "popphp/pop-mime": "^3.0.0-beta.1",
        "popphp/pop-utils": "^3.0.0-beta.4",
        "popphp/popphp": "^5.0.0-beta.20",
        "google/apiclient": "^v2.17.0",
        "aws/aws-sdk-php": "^3.316.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.0",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Pop\\Mail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pop\\Mail\\Test\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "5.0.x-dev"
        }
    }
}
